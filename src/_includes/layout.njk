<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    <meta name="keywords" content="Linked Open Usable Data, LOUD, IIIF, International Image Interoperability Framework, Linked Art, Web Annotation Data Model, W3C, Digital Humanities, Cultural Heritage, Linked Data, Semantic Interoperability, Community Practices, PhD, LUX: Yale Collections Discovery, University of Basel, Cultural Anthropology Switzerland, PIA, Participatory Knowledge Practices in Analogue and Digital Image Archives, {{ keywords }}">
    <meta name="author" content="Julien A. Raemy">
    <meta name="last-modified" content="{{ page.date.toISOString() }}">

    <!-- Dublin Core -->
    <meta name="DC.title" content="{{ title }}">
    <meta name="DC.creator" content="Raemy, Julien Antoine">
    <meta name="DC.date" content="{{ date }}">
    <meta name="DC.type" content="{{ schemaType }}">
    <meta name="DC.identifier" content="{{ site.url }}{{ page.url }}">
    <!-- Persistent identifiers of the thesis: Handle (primary) and DOI -->
    {% set isThesisPart = page.url.startsWith("/thesis/") %}
    {% set pidMeta = "DC.relation.isPartOf" if isThesisPart else "DC.identifier" %}
    {% if handle %}
    <meta name="{{ pidMeta }}" content="https://hdl.handle.net/{{ handle }}">
    {% endif %}
    {% if doi %}
    <meta name="{{ pidMeta }}" content="https://doi.org/{{ doi }}">
    {% endif %}
    <meta name="DC.description" content="{{ description }}">
    <meta name="DC.subject" content="{{ keywords }}">
    <meta name="DC.language" content="en">
    <meta name="DC.format" content="text/html">
    <meta name="DC.rights" content="https://creativecommons.org/licenses/by/4.0/">
    {% if place %}
    <meta name="DC.coverage" content="{{ place }}">
    {% endif %}
    {% if university %}
    <meta name="DC.publisher" content="{{ university }}">
    {% endif %}

    <!-- Title and CSS -->
    <title>{% if chapter %}{{ chapter }}. {{ title }} · Linked Open Usable Data for Cultural Heritage{% else %}{{ title }}{% endif %}</title>
    <link rel="stylesheet" href="/assets/stylesheets/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code&display=swap" rel="stylesheet">

    <!-- Theme: apply a saved light/dark choice before first paint -->
    <script>try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="https://julsraemy.ch/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="https://julsraemy.ch/favicon.svg" />
    <link rel="shortcut icon" href="https://julsraemy.ch/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://julsraemy.ch/apple-touch-icon.png" />
    <link rel="manifest" href="https://julsraemy.ch/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#2b5797">
    <meta name="theme-color" content="#ffffff">


    <!-- Me -->
    <link rel="me" href="https://hcommons.social/@julsraemy" />
    <link rel="me" href="https://www.wikidata.org/entity/Q59286487">
    <link rel="me" href="https://orcid.org/0000-0002-4711-5759">
    <link rel="me" href="https://scholar.google.ch/citations?user=pGROUG0AAAAJ">
    <link rel="me" href="https://www.linkedin.com/in/julienaraemy/">
    <link rel="me" href="https://www.researchgate.net/profile/Julien_Raemy">

    <!-- Schema.org -->
    <script type="application/ld+json">
    {
        "@context": [
            "https://schema.org",
            { "rdfs": "http://www.w3.org/2000/01/rdf-schema#", "seeAlso": { "@id": "rdfs:seeAlso", "@type": "@id" } }
        ],
        "@type": {{ (schemaType or "WebPage") | dump | safe }},
        "@id": {{ (site.url + page.url) | dump | safe }},
        "name": {{ title | dump | safe }},
        "url": {{ (site.url + page.url) | dump | safe }},
        {% if page.url.startsWith("/thesis/") %}{% if chapter %}"position": {{ chapter }},
        {% endif %}"isPartOf": {
            "@type": "Thesis",
            "@id": "{{ site.url }}/thesis.html",
            "name": "Linked Open Usable Data for Cultural Heritage: Perspectives on Community Practices and Semantic Interoperability",
            "identifier": ["https://hdl.handle.net/20.500.14716/148352", "https://doi.org/10.5451/unibas-ep96807"],
            "sameAs": "https://hdl.handle.net/20.500.14716/148352"
        },
        {% elif handle %}"identifier": ["https://hdl.handle.net/{{ handle }}"{% if doi %}, "https://doi.org/{{ doi }}"{% endif %}],
        "sameAs": "https://hdl.handle.net/{{ handle }}",
        {% endif %}"author": {
            "@type": "Person",
            "@id": "https://julsraemy.ch/#person",
            "name": "Julien Antoine Raemy",
            "identifier": "https://orcid.org/0000-0002-4711-5759",
            "seeAlso": "https://julsraemy.ch/me.json"
        },
        {% if university %}"sourceOrganization": {
            "@type": "CollegeOrUniversity",
            "@id": "https://ror.org/02s6k3f65",
            "name": {{ university | dump | safe }},
            "url": "https://www.unibas.ch/"
        },
        {% endif %}"datePublished": {{ (page.date.toISOString() | truncate(10, true, "")) | dump | safe }},
        "description": {{ (description or "") | dump | safe }},
        {% if keywords %}"keywords": {{ keywords | dump | safe }},
        {% endif %}"inLanguage": "en",
        "license": "https://creativecommons.org/licenses/by/4.0/"
    }
    </script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#content">Skip to content</a>
    {%- set navItems = [
        ["/", "Home"], ["/loud.html", "LOUD"], ["/thesis.html", "PhD Thesis"],
        ["/research.html", "Research Outcomes"], ["/pia.html", "PIA"]
    ] %}
    <nav class="site-nav" aria-label="Site">
        <button class="nav-trigger" type="button" aria-expanded="false" aria-controls="site-menu">Menu</button>
        <ul id="site-menu" class="collapsed">
            {%- for item in navItems %}
            {%- set active = (page.url == item[0]) or (item[0] == "/thesis.html" and page.url.startsWith("/thesis/")) %}
            <li><a href="{{ item[0] }}"{% if active %} aria-current="page"{% endif %}>{{ item[1] }}</a></li>
            {%- endfor %}
        </ul>
        <div id="controls" role="group" aria-label="Search and display settings">
            <a id="search-link" href="/search.html" title="Search" aria-label="Search"{% if page.url == "/search.html" %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.5"/><line x1="15.5" y1="15.5" x2="21" y2="21" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg></a>
            <button id="font-decrease" type="button" title="Smaller text" aria-label="Smaller text">A−</button>
            <button id="font-increase" type="button" title="Larger text" aria-label="Larger text">A+</button>
            <button id="theme-toggle" type="button" title="Switch between light and dark mode" aria-label="Dark mode" aria-pressed="false">◐</button>
        </div>
    </nav>

    {#- Search index (Pagefind): thesis pages index their <article>, other pages <main> #}
    {%- set indexMain = bodyClass != "thesis-page" and page.url != "/404.html" and not noSearchIndex %}
    <main id="content"{% if indexMain %} data-pagefind-body data-pagefind-filter="section:Website"{% endif %}>
    {{ content | references | safe }}
    </main>

    <footer>
        Created by <a href="https://julsraemy.ch" target="_blank">Julien Antoine Raemy</a> using <a href="https://www.11ty.dev/" target="_blank">11ty</a>, a static site generator. All content is released and distributed under the <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank">Creative Commons Attribution 4.0 International Licence (CC BY 4.0) <img alt="Creative Commons BY 4.0" src="https://julsraemy.ch/prezi/assets/cc-by.svg" width="50" /></a>
    </footer>
    <script src="/js/site.js"></script>
    {%- if viewers %}
    <script src="/js/viewers.js" defer></script>
    {%- endif %}
    <script type="module">
        // Highlight search terms when arriving from a search result
        if (new URLSearchParams(location.search).has("highlight")) {
            import("/pagefind/pagefind-highlight.js")
                .then(() => new PagefindHighlight({ highlightParam: "highlight" }))
                .catch(() => {});
        }
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TNJQKJHNDF"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TNJQKJHNDF');
    </script>
</body>
</html>
