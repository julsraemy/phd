<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    <meta name="keywords" content="Linked Open Usable Data, LOUD, IIIF, International Image Interoperability Framework, Linked Art, Web Annotation Data Model, W3C, Digital Humanities, Cultural Heritage, Linked Data, Semantic Interoperability, Community Practices, PhD, LUX: Yale Collections Discovery, University of Basel, Cultural Anthropology Switzerland, PIA, Participatory Knowledge Practices in Analogue and Digital Image Archives, {{ keywords }}">
    <meta name="author" content="Julien A. Raemy">
    <meta name="last-modified" content="{{ page.date.toISOString() }}">

    <!-- Dublin Core -->
    <meta name="DC.title" content="{{ title }}">
    <meta name="DC.creator" content="Raemy, Julien Antoine">
    <meta name="DC.date" content="{{ date }}">
    <meta name="DC.type" content="{{ schemaType }}">
    <meta name="DC.identifier" content="{{ site.url }}{{ page.url }}">
    <!-- Conditional DOI Identifier -->
    {% if doi %}
    <meta name="DC.identifier" content="https://doi.org/{{ doi }}">
    {% endif %}
    <meta name="DC.description" content="{{ description }}">
    <meta name="DC.subject" content="{{ keywords }}">
    <meta name="DC.language" content="en">
    <meta name="DC.format" content="text/html">
    <meta name="DC.rights" content="https://creativecommons.org/licenses/by/4.0/">
    {% if place %}
    <meta name="DC.coverage" content="{{ place }}">
    {% endif %}
    {% if university %}
    <meta name="DC.publisher" content="{{ university }}">
    {% endif %}

    <!-- Title and CSS -->
    <title>{% if chapter %}{{ chapter }}. {{ title }} · Linked Open Usable Data for Cultural Heritage{% else %}{{ title }}{% endif %}</title>
    <link rel="stylesheet" href="/assets/stylesheets/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code&display=swap" rel="stylesheet">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css"/>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>

    <!-- jQuery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>

    <!-- Leaflet-IIIF -->
    <script src="https://cdn.rawgit.com/mejackreed/Leaflet-IIIF/v2.0.1/leaflet-iiif.js"></script>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="https://julsraemy.ch/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="https://julsraemy.ch/favicon.svg" />
    <link rel="shortcut icon" href="https://julsraemy.ch/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://julsraemy.ch/apple-touch-icon.png" />
    <link rel="manifest" href="https://julsraemy.ch/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#2b5797">
    <meta name="theme-color" content="#ffffff">


    <!-- Me -->
    <link rel="me" href="https://hcommons.social/@julsraemy" />
    <link rel="me" href="https://www.wikidata.org/entity/Q59286487">
    <link rel="me" href="https://orcid.org/0000-0002-4711-5759">
    <link rel="me" href="https://scholar.google.ch/citations?user=pGROUG0AAAAJ">
    <link rel="me" href="https://www.linkedin.com/in/julienaraemy/">
    <link rel="me" href="https://www.researchgate.net/profile/Julien_Raemy">

    <!-- Schema.org -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": {{ (schemaType or "WebPage") | dump | safe }},
        "name": {{ title | dump | safe }},
        "url": {{ (site.url + page.url) | dump | safe }},
        {% if doi %}"identifier": {{ ("https://doi.org/" + doi) | dump | safe }},
        {% endif %}{% if chapter %}"isPartOf": {
            "@type": "Thesis",
            "name": "Linked Open Usable Data for Cultural Heritage: Perspectives on Community Practices and Semantic Interoperability",
            "url": "{{ site.url }}/thesis.html"
        },
        {% endif %}"author": {
            "@type": "Person",
            "@id": "https://julsraemy.ch/#person",
            "name": "Julien Antoine Raemy",
            "alternateName": "Julien A. Raemy",
            "givenName": "Julien Antoine",
            "familyName": "Raemy",
            "url": "https://julsraemy.ch/",
            "jobTitle": "Semantic Architect and Project Manager",
            "worksFor": { "@type": "Organization", "name": "docuteam", "url": "https://www.docuteam.ch/" },
            "affiliation": {
                "@type": "Organization",
                "name": "Walter Benjamin Kolleg / Digital Humanities Center",
                "url": "https://www.dh.unibe.ch/",
                "parentOrganization": {
                    "@type": "CollegeOrUniversity",
                    "@id": "https://ror.org/02k7v4d05",
                    "name": "University of Bern"
                }
            },
            "alumniOf": [
                { "@type": "CollegeOrUniversity", "@id": "https://ror.org/02s6k3f65", "name": "University of Basel" },
                {
                    "@type": "CollegeOrUniversity",
                    "name": "Haute école de gestion de Genève",
                    "parentOrganization": { "@type": "CollegeOrUniversity", "@id": "https://ror.org/01xkakk17", "name": "HES-SO University of Applied Sciences and Arts Western Switzerland" }
                }
            ],
            "identifier": { "@type": "PropertyValue", "propertyID": "ORCID", "value": "0000-0002-4711-5759" },
            "sameAs": [
                "https://orcid.org/0000-0002-4711-5759",
                "https://www.wikidata.org/wiki/Q59286487",
                "https://hcommons.social/@julsraemy",
                "https://www.linkedin.com/in/julienaraemy/",
                "https://www.researchgate.net/profile/Julien_Raemy",
                "https://www.zotero.org/julsraemy",
                "https://scholar.google.ch/citations?user=pGROUG0AAAAJ",
                "https://viaf.org/viaf/1239155284804887060759/",
                "https://www.semanticscholar.org/author/Julien-A.-Raemy/72004221"
            ]
        },
        {% if university %}"sourceOrganization": { "@type": "CollegeOrUniversity", "@id": "https://ror.org/02s6k3f65", "name": {{ university | dump | safe }} },
        {% endif %}"datePublished": {{ (page.date.toISOString() | truncate(10, true, "")) | dump | safe }},
        "description": {{ (description or "") | dump | safe }},
        "keywords": {{ (keywords or "") | dump | safe }},
        "inLanguage": "en",
        "license": "https://creativecommons.org/licenses/by/4.0/"
    }
    </script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <nav>
        <button class="nav-trigger">Menu</button>
        <ul class="collapsed">
            <li><a href="/">Home</a></li>
            <li><a href="/loud.html">LOUD</a></li>
            <li><a href="/thesis.html">PhD Thesis</a></li>
            <li><a href="/research.html">Research Outcomes</a></li>
            <li><a href="/pia.html">PIA</a></li>
        </ul>
    </nav>

    <!-- Theme and Font Size Controls -->
    <div id="controls">
        <button id="font-increase">A+</button>
        <button id="font-decrease">A-</button>
    </div>
    
    <header>
        <!-- Header content here -->
    </header>
    
    <main>
    {{ content | references | safe }}
    </main>


    <footer>
        Created by <a href="https://julsraemy.ch" target="_blank">Julien Antoine Raemy</a> using <a href="https://www.11ty.dev/" target="_blank">11ty</a>, a static site generator. All content is released and distributed under the <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank">Creative Commons Attribution 4.0 International Licence (CC BY 4.0) <img alt="Creative Commons BY 4.0" src="https://julsraemy.ch/prezi/assets/cc-by.svg" width="50" /></a>
    </footer>
    <script src="/js/accordion.js"></script>
    <script src="/js/leaflet-iiif-init.js"></script>
    <script src="/js/font-size.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TNJQKJHNDF"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TNJQKJHNDF');
    </script>
</body>
</html>
