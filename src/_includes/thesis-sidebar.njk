{%- macro entry(item, current) -%}
<a href="{{ item.url }}"{% if current %} aria-current="page"{% endif %}>{% if item.num %}<span class="toc-num">{{ item.num }}</span>{% endif %}<span class="toc-text">{{ item.title }}</span></a>
{%- endmacro -%}
{%- macro tocItem(ch, cls) -%}
{%- set current = (ch.url == page.url) %}
<li class="{{ cls }}{% if current %} is-current{% endif %}">
  {%- if ch.sections.length %}
  <details{% if current %} open{% endif %}>
    <summary>{{ entry(ch, current) }}</summary>
    <ol>
      {%- for s in ch.sections %}
      <li><a href="{{ s.url }}" data-target="{{ s.id }}">{% if s.num %}<span class="toc-num">{{ s.num }}</span>{% endif %}<span class="toc-text">{{ s.title }}</span></a>
        {%- if current and s.children.length %}
        <ol>
          {%- for c in s.children %}
          <li><a href="{{ c.url }}" data-target="{{ c.id }}"><span class="toc-num">{{ c.num }}</span><span class="toc-text">{{ c.title }}</span></a></li>
          {%- endfor %}
        </ol>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
  </details>
  {%- else %}
  {{ entry(ch, current) }}
  {%- endif %}
</li>
{%- endmacro -%}
<nav class="toc-nav" aria-label="Thesis contents">
  <p class="toc-heading"><a href="/thesis.html">LOUD for Cultural Heritage</a></p>
  <ol class="toc-list">
    <li class="toc-front{% if page.url == '/thesis.html' %} is-current{% endif %}"><a href="/thesis.html"{% if page.url == '/thesis.html' %} aria-current="page"{% endif %}><span class="toc-text">Title &amp; Abstract</span></a></li>
    {%- for p in thesisToc.front %}{{ tocItem(p, "toc-front") }}{% endfor %}
  </ol>
  <ol class="toc-list toc-main">
    {%- for ch in thesisToc.chapters %}{{ tocItem(ch, "toc-chapter") }}{% endfor %}
  </ol>
  <ol class="toc-list toc-back">
    {%- for p in thesisToc.back %}{{ tocItem(p, "toc-back") }}{% endfor %}
  </ol>
  <p class="toc-pdf"><a href="https://doi.org/10.5451/unibas-ep96807">PDF version (edoc)</a></p>
</nav>
